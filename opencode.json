{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "instructions": ["local.md"],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 30000
    },
    "buffer": "20%"
  },
  "experimental": {
    "subagent_depth": 2,
    "background_compaction": true
  },
  "permissions": [
    {
      "action": "delete",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "session_move",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "browser_*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "browser": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@0.0.83", "--browser", "chrome"],
        "codemode": false,
        "timeout": { "startup": 120000 }
      }
    }
  }
}
